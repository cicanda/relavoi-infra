project       = "relavoi"
environment   = "staging"
aws_region    = "eu-north-1"
aws_profile   = "relavoi"
domain_name   = "relavoi.com"
instance_type = "t3.small"

# Create a key pair in AWS console first, download the .pem file
key_pair_name = "relavoi-staging"

# Restrict SSH to your IP (find yours at whatismyip.com)
ssh_allowed_cidr = "YOUR_IP/32"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
jwt_secret            = "CHANGE_THIS"
encryption_master_key = "CHANGE_THIS"
db_password           = "CHANGE_THIS"

# Africa's Talking
at_api_key     = "YOUR_AT_API_KEY"
at_username    = "sandbox"
at_environment = "sandbox"

# Vercel frontend URLs (update after deploying to Vercel)
cors_origins = "https://app.relavoi.com,https://admin.relavoi.com,http://localhost:3001,http://localhost:3003"
